[Unit]
Description=ROS PC Manager Web Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__PROJECT_ROOT__
Environment=__SERVER_CONFIG_ENV__
ExecStart=__SERVER_EXEC__
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
