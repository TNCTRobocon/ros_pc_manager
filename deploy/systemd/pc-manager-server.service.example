[Unit]
Description=ROS PC Manager Web Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__PROJECT_ROOT__
Environment=ROS_PC_MANAGER_CONFIG=__PROJECT_ROOT__/config/server.yaml
ExecStart=__PROJECT_ROOT__/.venv/bin/ros-pc-manager-server
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
