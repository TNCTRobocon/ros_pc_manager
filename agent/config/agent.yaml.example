agent:
  id: ""
  name: robot-a
  host: 0.0.0.0
  port: 8765
  # Automatically generated by setup_agent_service.sh on first setup.
  token: REPLACE_WITH_AUTO_GENERATED_TOKEN
  ros_setup: /opt/ros/jazzy/setup.bash
  default_domain_id: 32

ros:
  overlays: []

discovery:
  enabled: true

paths:
  launches_file: launches.yaml
  state_file: ~/.local/state/ros-pc-manager/launches.json
  log_root: ~/.local/state/ros-pc-manager/logs
  rosbag_root: ~/.local/state/ros-pc-manager/rosbags
  rosbag_state: ~/.local/state/ros-pc-manager/rosbag_state.json

limits:
  minimum_free_gb: 5
  warning_free_gb: 10
